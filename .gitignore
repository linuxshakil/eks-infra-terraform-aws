#############################################################
# Terraform local working directories & caches
#############################################################
**/.terraform/*
**/.terraform.lock.hcl.tmp

#############################################################
# State files — NEVER commit these (they live in S3 remote backend)
#############################################################
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform.tfstate.lock.info
.terraform.tfstate.lock

#############################################################
# Plan files — generated by CI/local runs, never commit
#############################################################
*.tfplan
tfplan
destroy.tfplan
*.plan

#############################################################
# Terraform CLI config / crash logs
#############################################################
crash.log
crash.*.log
.terraformrc
terraform.rc

#############################################################
# Override files — used for local testing only, never commit
#############################################################
override.tf
override.tf.json
*_override.tf
*_override.tf.json

#############################################################
# Sensitive variable files
# (keep this commented IF your .tfvars only has non-secret values
#  like project_id/region; uncomment if you ever put secrets in one)
#############################################################
#*.tfvars
#*.tfvars.json

#############################################################
# CI-generated output/log artifacts (terraform-output.json, apply logs)
#############################################################
terraform-output.json
terraform-apply.log
terraform-destroy.log
*.log

#############################################################
# Any local credential / key files — extra safety net
# (this repo uses WIF, so these should never exist, but ignore
#  them anyway in case someone downloads one locally for debugging)
#############################################################
*.pem
*.key
*-key.json
service-account*.json
aws_access_key*
aws-credentials.json
kubeconfig
kubeconfig.yaml
.kube/config

#############################################################
# OS / editor junk
#############################################################
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

#############################################################
# Misc local scratch
#############################################################
*.zip
*.tar.gz
.env
.env.*
